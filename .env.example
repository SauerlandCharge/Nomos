# Kopiere diese Datei zu ".env" und trage deinen Anthropic API-Key ein.
# Den Key bekommst du unter https://console.anthropic.com  → Settings → API Keys.
# WICHTIG: .env wird NICHT eingecheckt (siehe .gitignore). Der Key gehört niemals in den Code.

ANTHROPIC_API_KEY=sk-ant-...

# Optional:
PORT=3000
# Modelle: deep = stark (Analyse/Antrag/Businessplan), fast = schnell (Rückfragen/
# Compliance/Checklisten/Übersetzung). Defaults: Sonnet 4.6 / Haiku 4.5.
NOMOS_MODEL=claude-sonnet-4-6
NOMOS_MODEL_FAST=claude-haiku-4-5

# Konten/Sessions: Geheimnis zum Signieren der Login-Cookies.
# Lokal optional (Fallback aktiv); in PRODUKTION zwingend setzen (langer Zufallswert).
SESSION_SECRET=

# Speicher: ist DATABASE_URL gesetzt, nutzt Nomos PostgreSQL — sonst eine lokale
# JSON-Datei (data/store.json). Für Produktion/gehostet eine Postgres-URL eintragen.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
